DATABASE_URL="postgresql://collaboration:local-development-only@localhost:5432/collaboration?schema=public"
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
APP_OWNER_UID=replace-with-owner-firebase-uid
APP_COLLABORATOR_UID=replace-with-collaborator-firebase-uid
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
STORAGE_DIR=.data/private-images

# Optional locally when using Application Default Credentials instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id
