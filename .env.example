DATABASE_URL="postgresql://collaboration:local-development-only@localhost:5432/collaboration?schema=public"
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
APP_OWNER_UID=
APP_COLLABORATOR_UID=
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
STORAGE_PROVIDER=local
STORAGE_DIR=.data/private-images

# For Supabase production image storage, set STORAGE_PROVIDER=supabase and
# configure the Supabase project URL, private bucket, and service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-images

# Optional Google Cloud Storage backend; set STORAGE_PROVIDER=gcs.
GCS_BUCKET=

# Optional locally when using Application Default Credentials instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
SEED_USER_A_EMAIL=
SEED_USER_A_PASSWORD=
SEED_USER_B_EMAIL=
SEED_USER_B_PASSWORD=

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id
