{
  "name": "company-collaboration-platform",
  "private": true,
  "workspaces": [
    "packages/domain",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @company-platform/api run start:dev",
    "dev:web": "npm --workspace @company-platform/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:api": "npm --workspace @company-platform/api test",
    "test:web": "npm --workspace @company-platform/web test",
    "db:generate": "npm --workspace @company-platform/api run db:generate",
    "db:migrate": "npm --workspace @company-platform/api run db:migrate",
    "db:deploy": "npm --workspace @company-platform/api run db:deploy",
    "db:seed": "npm --workspace @company-platform/api run db:seed"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "fast-xml-parser": "5.11.2",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "node-forge": "1.4.0",
    "postcss": "8.5.30",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "@firebase/util": true,
    "esbuild": true,
    "protobufjs": true,
    "unrs-resolver": true,
    "prisma": true
  }
}
